PGDATABASE=evidence
PGUSER=evidence
PGPASSWORD=replace-with-a-long-random-secret
KC_DB_PASSWORD=replace-with-another-long-random-secret
EVIDENCE_PGHOST=database
EVIDENCE_PGPORT=5432
EVIDENCE_PGDATABASE=evidence
EVIDENCE_PGUSER=evidence
EVIDENCE_PGPASSWORD=replace-with-a-long-random-secret
KEYCLOAK_PGHOST=identity-database
KEYCLOAK_PGPORT=5432
KEYCLOAK_PGDATABASE=keycloak
KEYCLOAK_PGUSER=keycloak
KEYCLOAK_PGPASSWORD=replace-with-another-long-random-secret
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
OIDC_PUBLIC_URL=https://identity.example.com
MCP_PUBLIC_URL=https://evidence.example.com/mcp
MCP_ALLOWED_HOSTS=evidence.example.com,evidence.example.com:443
MCP_ALLOWED_ORIGINS=
# Staging only: allow plaintext HTTP issuer/public URLs on private LAN IPs.
# Never set this when a domain and real TLS are available.
MCP_INSECURE_PRIVATE_HTTP=false

# Vault: base64 of 32 random bytes (python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())").
# Back this key up separately from the database; losing it makes every stored secret unrecoverable.
VAULT_MASTER_KEY=
# Web UI at /ui with Google login (enabled only when all three of UI_SESSION_SECRET, GOOGLE_CLIENT_ID and
# GOOGLE_CLIENT_SECRET are set). UI_SESSION_SECRET: 32+ random characters.
# Google Cloud Console -> OAuth client (Web application); authorised redirect URI: <MCP_PUBLIC_URL origin>/ui/callback
UI_SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated Gmail/Google addresses that are administrators (auto-created on first login).
# Everyone else must first be added by an admin; unknown Google accounts are refused.
ADMIN_EMAILS=
